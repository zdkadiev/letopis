 fn line_start(text: &str, at: usize) -> usize {
     text.as_bytes()[..at]
         .iter()
         .rposition(|&c| c == b'\n')
         .map_or(0, |p| p + 1)
 }
 fn line_after(text: &str, at: usize) -> usize {
     text.as_bytes()[at..]
         .iter()
         .position(|&c| c == b'\n')
         .map_or(text.len(), |p| at + p + 1)
 }
