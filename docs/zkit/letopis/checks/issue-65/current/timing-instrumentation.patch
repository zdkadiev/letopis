+//! Temporary operation-local timing profiler; diagnostic build only.
+use std::{sync::atomic::{AtomicU64, Ordering}, time::Instant};
+static CALLS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+static NANOS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+const LABELS: [&str; 18] = ["src/service/inspection.rs::inspect", "src/service/inspection.rs::capture_file", "src/service/inspection.rs::capture_sources", "src/service/inspection.rs::assemble_tree", "src/git/durability.rs::new_with_cleanup", "src/git/durability.rs::object_publish", "src/git/durability.rs::object_verify_existing", "src/git/durability.rs::ref_retain_by_oid", "src/git/durability.rs::directory_sync_parent_chain", "src/git/objects.rs::tree_assemble", "src/git/objects.rs::blob_get_by_tree_oid_and_path", "src/git/refs.rs::tree_pin_by_oid", "src/git/refs.rs::tree_verify_closure_by_oid", "src/markdown/parser.rs::file_parse", "src/filesystem/file.rs::file_get_by_path", "src/service/provenance.rs::get_snapshot_hash", "src/service/provenance.rs::get_current_hash", "src/service/provenance.rs::observe_sources_batch"];
+/// Records one inclusive wall-time scope.
+#[derive(Debug)]
+pub struct Scope { index: usize, started: Instant }
+/// Starts an operation-local timer.
+pub fn enter(index: usize) -> Scope { Scope { index, started: Instant::now() } }
+impl Drop for Scope {
+    fn drop(&mut self) {
+        CALLS[self.index].fetch_add(1, Ordering::Relaxed);
+        NANOS[self.index].fetch_add(u64::try_from(self.started.elapsed().as_nanos()).unwrap_or(u64::MAX), Ordering::Relaxed);
+    }
+}
+/// Emits bounded aggregate function counts and inclusive nanoseconds on exit.
+#[derive(Debug)]
+pub struct Report;
+impl Drop for Report {
+    fn drop(&mut self) {
+        for (index, label) in LABELS.iter().enumerate() {
+            eprintln!("{}", serde_json::json!({"function": label,
+                "calls": CALLS[index].load(Ordering::Relaxed),
+                "inclusive_nanoseconds": NANOS[index].load(Ordering::Relaxed)}));
+        }
+    }
+}
